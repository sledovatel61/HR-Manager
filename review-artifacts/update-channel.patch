diff --git a/.github/workflows/update-channel.yml b/.github/workflows/update-channel.yml
new file mode 100644
index 0000000..1740b803b075de94715409167f15e42004ebdbd6
--- /dev/null
+++ b/.github/workflows/update-channel.yml
+#
+# Собирает release channel только для ЗАЩИЩЁННЫХ SemVer-тегов `v*` (или
+# ручного dispatch владельца): детерминированный пакет + внешний
+# update-channel.json, подписанный Ed25519-ключом ИЗ SECRET, независимая
+# проверка подписи тем публичным ключом, которому доверяет production-клиент,
+# затем — публикация immutable артефактов (GitHub Release + SHA256SUMS +
+# provenance). Существующий deploy/rollback workflow (release.yml) НЕ
+# затрагивается: развёртывание серверной части и публикация канала
+# Windows-пилота — раздельные цепочки без регрессии Phase 7/12.
+#
+# Секреты живут в environment `update-channel-signing` (создать владельцу;
+# НЕ включать в настройках environment ветки PR):
+#   UPDATE_CHANNEL_SIGNING_KEY — закрытый Ed25519-ключ (64 hex или PEM);
+#   UPDATE_CHANNEL_KEY_ID      — key_id подписи (напр. pilot-release-2026);
+#   UPDATE_CHANNEL_PUBLIC_KEYS — trust store production-клиента, тот же JSON
+#                                {key_id: {key, revoked}}, что в
+#                                UPDATE_CHANNEL_PUBLIC_KEYS сервера.
+# Fail closed: без signing key (или с неверным) pipeline падает ДО создания
+# unsigned manifest — см. infra/release/publish_channel.py.
+#
+# Production signing secret НЕ доступен коду из PR/fork: триггеров
+# pull_request нет, signing выполняется только внутри environment-джоба.
+#
+# Защита тегов (владелец): tag protection rules — разрешить только `v*`
+# (SemVer), писать теги может только владелец/CI.
+name: Update channel release
+
+on:
+  push:
+    tags: ["v[0-9]+.[0-9]+.[0-9]+"]
+  workflow_dispatch:
+    inputs:
+      version:
+        description: "SemVer release (например 0.14.0)"
+        required: true
+      release_sha:
+        description: "Полный Git commit (40 hex)"
+        required: true
+      notes_ru:
+        description: "Примечания к релизу (одна строка)"
+        required: false
+      key_id:
+        description: "key_id подписи (секрет UPDATE_CHANNEL_KEY_ID)"
+        required: false
+        default: "pilot-release"
+
+permissions:
+  contents: read
+
+env:
+  # Порог поддержки канала: менять владельцу при поднятии планки
+  # (аналог ExpectedHeadRevision в Windows-движке).
+  MINIMUM_SUPPORTED_VERSION: "0.13.0"
+
+jobs:
+  windows-installer:
+    name: Build Windows installer (pinned toolchain)
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Resolve version for the installer
+        id: version
+        shell: bash
+        run: |
+          case "${{ github.event_name }}" in
+            push)
+              version="${GITHUB_REF_NAME#v}"
+              ;;
+            workflow_dispatch)
+              version="${{ inputs.version }}"
+              ;;
+          esac
+          echo "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || {
+            echo "error: version must be SemVer x.y.z" >&2; exit 2; }
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+
+      - name: Build installer (Inno Setup 6.7.3, SHA256 pinned in build.ps1)
+        shell: powershell
+        run: powershell -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1 -Version ${{ steps.version.outputs.version }}
+
+      - name: Upload installer artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: hr-manager-windows-setup
+          path: installer/output/*.exe
+          if-no-files-found: error
+
+  channel-release:
+    name: Build, sign, verify and publish update channel
+    needs: windows-installer
+    runs-on: ubuntu-latest
+    environment: update-channel-signing
+    permissions:
+      contents: write
+      id-token: write
+      attestations: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Resolve release facts (protected SemVer tag or owner dispatch)
+        id: release
+        run: |
+          case "${{ github.event_name }}" in
+            push)
+              version="${GITHUB_REF_NAME#v}"
+              sha="$(git rev-parse HEAD)"
+              notes=""
+              ;;
+            workflow_dispatch)
+              version="${{ inputs.version }}"
+              sha="${{ inputs.release_sha }}"
+              notes="${{ inputs.notes_ru }}"
+              ;;
+          esac
+          echo "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || {
+            echo "error: version must be SemVer x.y.z" >&2; exit 2; }
+          echo "$sha" | grep -Eq '^[0-9a-fA-F]{40}$' || {
+            echo "error: release_sha must be a full 40-char git SHA" >&2; exit 2; }
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+          echo "sha=$sha" >> "$GITHUB_OUTPUT"
+          echo "notes=$notes" >> "$GITHUB_OUTPUT"
+          echo "tag=v$version" >> "$GITHUB_OUTPUT"
+          # Immutable URL пакета (детерминированный: известен до публикации;
+          # активы GitHub Release неизменяемы после загрузки).
+          echo "package_url=https://github.com/${GITHUB_REPOSITORY}/releases/download/v$version/hr-manager-windows-$version.zip" >> "$GITHUB_OUTPUT"
+
+      - name: Mandatory CI checks must be green for the release commit
+        env:
+          GH_TOKEN: ${{ github.token }}
+          SHA: ${{ steps.release.outputs.sha }}
+        run: |
+          runs="$(gh api "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${SHA}&per_page=20" \
+            --jq '.workflow_runs[] | select(.name=="CI" and .status=="completed" and .conclusion=="success") | .head_sha' | head -1)"
+          [ -n "$runs" ] || { echo "error: no successful CI run for ${SHA}; release refused" >&2; exit 1; }
+          echo "CI is green for ${SHA}"
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install channel tooling (pinned)
+        run: pip install cryptography==50.0.1
+
+      - name: Prepare snapshot (backend + frontend + infra + release.json)
+        id: snapshot
+        env:
+          VERSION: ${{ steps.release.outputs.version }}
+          SHA: ${{ steps.release.outputs.sha }}
+        run: |
+          set -euo pipefail
+          snapshot="$(mktemp -d)/app"
+          mkdir -p "$snapshot"
+          cp -R backend "$snapshot/backend"
+          cp -R frontend "$snapshot/frontend"
+          cp -R infra "$snapshot/infra"
+          python3 - "$snapshot/release.json" <<'PY'
+          import json, os, sys
+          from datetime import UTC, datetime
+          with open(sys.argv[1], "w", encoding="utf-8") as fh:
+              json.dump({
+                  "version": os.environ["VERSION"],
+                  "release_sha": os.environ["SHA"],
+                  "built_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
+              }, fh, ensure_ascii=False)
+          PY
+          echo "snapshot=$snapshot" >> "$GITHUB_OUTPUT"
+
+      - name: Build package, sign manifest, verify with client-trusted key
+        env:
+          VERSION: ${{ steps.release.outputs.version }}
+          SHA: ${{ steps.release.outputs.sha }}
+          NOTES: ${{ steps.release.outputs.notes }}
+          PACKAGE_URL: ${{ steps.release.outputs.package_url }}
+          # Секреты environment update-channel-signing. Fail closed:
+          # publish_channel.py падает, если ключ или trust store отсутствуют.
+          SIGNING_KEY: ${{ secrets.UPDATE_CHANNEL_SIGNING_KEY }}
+          KEY_ID: ${{ secrets.UPDATE_CHANNEL_KEY_ID }}
+          TRUSTED_KEYS: ${{ secrets.UPDATE_CHANNEL_PUBLIC_KEYS }}
+        run: |
+          set -euo pipefail
+          : "${SIGNING_KEY:?UPDATE_CHANNEL_SIGNING_KEY secret is required}"
+          : "${KEY_ID:?UPDATE_CHANNEL_KEY_ID secret is required}"
+          : "${TRUSTED_KEYS:?UPDATE_CHANNEL_PUBLIC_KEYS secret is required}"
+          printf '%s' "$SIGNING_KEY" > /tmp/update-channel-signing.key
+          printf '%s' "$TRUSTED_KEYS" > /tmp/update-channel-trusted-keys.json
+          python3 infra/release/publish_channel.py \
+            --snapshot "${{ steps.snapshot.outputs.snapshot }}" \
+            --version "$VERSION" \
+            --release-sha "$SHA" \
+            --package-url "$PACKAGE_URL" \
+            --minimum-supported-version "$MINIMUM_SUPPORTED_VERSION" \
+            --notes-ru "$NOTES" \
+            --private-key /tmp/update-channel-signing.key \
+            --key-id "$KEY_ID" \
+            --public-keys-json /tmp/update-channel-trusted-keys.json \
+            --out-dir dist/channel
+          rm -f /tmp/update-channel-signing.key
+
+      - name: Attest package provenance (no signing secret involved)
+        uses: actions/attest-build-provenance@v2
+        with:
+          subject-path: "dist/channel/hr-manager-windows-${{ steps.release.outputs.version }}.zip"
+
+      - name: Download installer artifact
+        uses: actions/download-artifact@v4
+        with:
+          name: hr-manager-windows-setup
+          path: dist/channel/installer
+
+      - name: Publish immutable GitHub Release (draft, assets verified above)
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ steps.release.outputs.tag }}
+          SHA: ${{ steps.release.outputs.sha }}
+          NOTES: ${{ steps.release.outputs.notes }}
+          VERSION: ${{ steps.release.outputs.version }}
+        run: |
+          set -euo pipefail
+          setup_exe="$(ls dist/channel/installer/HR-Manager-Setup-*.exe | head -1)"
+          [ -n "$setup_exe" ] || { echo "error: installer exe missing" >&2; exit 1; }
+          gh release create "$TAG" \
+            --target "$SHA" \
+            --draft \
+            --title "HR Manager Windows pilot $VERSION" \
+            --notes "${NOTES:-$VERSION}" \
+            "dist/channel/hr-manager-windows-$VERSION.zip" \
+            "dist/channel/update-channel.json" \
+            "dist/channel/SHA256SUMS" \
+            "$setup_exe"
