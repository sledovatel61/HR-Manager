From 6d5d1b2cfe16485ac95600a68e4c408f2ee1042b Mon Sep 17 00:00:00 2001
From: sledovatel61 <256329293+sledovatel61@users.noreply.github.com>
Date: Wed, 2 Sep 2026 09:03:33 +0000
Subject: [PATCH] ci: publish GitHub Actions workflow
 (.github/workflows/ci.yml)

---
 .github/workflows/ci.yml | 176 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 176 insertions(+)
 create mode 100644 .github/workflows/ci.yml

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..a505799
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,176 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+env:
+  PYTHON_VERSION: "3.12"
+  # Keep in sync with frontend/Dockerfile and frontend/package.json engines.
+  NODE_VERSION: "22.22.3"
+
+jobs:
+  backend:
+    name: Backend checks
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: pip
+          cache-dependency-path: backend/requirements*.txt
+      - name: Install dependencies
+        run: |
+          pip install -r requirements.txt -r requirements-dev.txt
+      - name: Ruff lint
+        run: ruff check .
+      - name: Ruff format check
+        run: ruff format --check .
+      - name: Mypy typecheck
+        run: mypy app tests
+      - name: Unit tests
+        run: pytest -m "not integration" -v
+      - name: Production preflight script checks
+        working-directory: .
+        run: |
+          # The preflight must REJECT missing/insecure configuration...
+          if bash infra/scripts/check_env.sh; then
+            echo "expected failure without configuration" >&2; exit 1
+          fi
+          if env -i PATH=/usr/bin:/bin APP_ENV=production bash infra/scripts/check_env.sh; then
+            echo "expected failure without secrets" >&2; exit 1
+          fi
+          if env -i PATH=/usr/bin:/bin APP_ENV=production \
+              SECRET_KEY=dev-only-secret-key-not-for-production \
+              POSTGRES_PASSWORD=strong-ci-pass-123 \
+              bash infra/scripts/check_env.sh; then
+            echo "expected failure for dev SECRET_KEY" >&2; exit 1
+          fi
+          if env -i PATH=/usr/bin:/bin APP_ENV=production \
+              SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_hex(32))')" \
+              POSTGRES_PASSWORD=hr_manager_dev_password \
+              bash infra/scripts/check_env.sh; then
+            echo "expected failure for dev DB password" >&2; exit 1
+          fi
+          # ...and ACCEPT a fully configured production environment.
+          env -i PATH=/usr/bin:/bin APP_ENV=production \
+            SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_hex(32))')" \
+            POSTGRES_PASSWORD="$(python3 -c 'import secrets; print(secrets.token_hex(16))')" \
+            bash infra/scripts/check_env.sh
+
+  frontend:
+    name: Frontend checks
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: frontend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: ${{ env.NODE_VERSION }}
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - name: Install dependencies
+        run: npm ci
+      - name: ESLint
+        run: npm run lint
+      - name: Typecheck
+        run: npm run typecheck
+      - name: Unit tests
+        run: npm run test
+      - name: Production build
+        run: npm run build
+      - name: Dependency audit (high and above)
+        run: npm audit --audit-level=high
+
+  integration:
+    name: Backend integration tests (PostgreSQL)
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_DB: hr_manager_test
+          POSTGRES_USER: hr_manager
+          POSTGRES_PASSWORD: hr_manager_ci_password
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U hr_manager -d hr_manager_test"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ env.PYTHON_VERSION }}
+          cache: pip
+          cache-dependency-path: backend/requirements*.txt
+      - name: Install dependencies
+        run: |
+          pip install -r requirements.txt -r requirements-dev.txt
+      - name: Integration tests (real PostgreSQL + migration pipeline)
+        env:
+          TEST_DATABASE_URL: postgresql+psycopg://hr_manager:hr_manager_ci_password@localhost:5432/hr_manager_test
+        run: pytest -m integration -v
+
+  stack:
+    name: Compose stack smoke test (dev + prod overlay)
+    runs-on: ubuntu-latest
+    needs: [backend, frontend]
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Validate dev Compose configuration
+        run: docker compose -f infra/docker-compose.yml config
+
+      - name: Validate production overlay configuration
+        run: |
+          export APP_ENV=production
+          export SECRET_KEY="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
+          export POSTGRES_PASSWORD="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
+          docker compose -f infra/docker-compose.yml -f infra/compose.prod.yml config -q
+          rendered="$(docker compose -f infra/docker-compose.yml -f infra/compose.prod.yml config)"
+          if echo "$rendered" | grep -q 'hr_manager_dev_password'; then
+            echo "production configuration leaks development credentials" >&2
+            exit 1
+          fi
+          if echo "$rendered" | grep -qE 'published:\s*"'; then
+            echo "production configuration publishes external ports" >&2
+            exit 1
+          fi
+          echo "production overlay is clean (no dev credentials, no published ports)"
+
+      - name: Build and start the full stack (wait for healthy)
+        run: docker compose -f infra/docker-compose.yml up --build --wait --wait-timeout 300
+
+      - name: Verify backend /health returns HTTP 200
+        run: |
+          code="$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8000/health)"
+          [ "$code" = "200" ] || { echo "expected 200, got $code" >&2; exit 1; }
+          curl -fsS http://localhost:8000/health | grep -q '"status":"ok"'
+
+      - name: Verify frontend serves the app and proxies the API
+        run: |
+          curl -fsS http://localhost:8080/ | grep -q 'HR Manager'
+          curl -fsS http://localhost:8080/api/health | grep -q '"status":"ok"'
+
+      - name: Stop PostgreSQL and verify degraded health (HTTP 503)
+        run: |
+          docker compose -f infra/docker-compose.yml stop db
+          code="$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8000/health)"
+          [ "$code" = "503" ] || { echo "expected 503, got $code" >&2; exit 1; }
+
+      - name: Clean up the stack
+        if: always()
+        run: docker compose -f infra/docker-compose.yml down -v --remove-orphans
-- 
