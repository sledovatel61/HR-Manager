# HR Manager backup service image.
#
# The application runtime plus PostgreSQL 16 client tools (pg_dump /
# pg_restore) built from source and the backup scheduler script. It never
# contains secrets: encryption keys and database credentials come from the
# runtime environment only, and backups are written to a dedicated volume
# (mounted at /var/backups/hr-manager), never into an image layer.
#
# Why build pg_dump from source instead of apt? The exact PostgreSQL minor
# version is pinned (16.15) and every download is checksum-verified
# (sha256sum -c), which gives a reproducible toolchain independent of the
# PGDG apt repository state. The build recipe is validated locally in the
# agent sandbox (same commands) and the resulting binaries are exercised
# against a real PostgreSQL 16 in CI.
#
# KEEP IN SYNC with backend/Dockerfile (same base image pin, same install
# steps, same unprivileged user); tests/test_production_overlay.py checks
# the parity so a silent drift fails CI.
#
# Build context: the repository root (see infra/docker-compose.yml), so both
# backend/ and infra/scripts/ are available to COPY.
FROM python:3.12-slim AS pgtools

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=UTC

# Build-time only toolchain (never copied into the final image). perl is
# required by PostgreSQL's configure script and is absent from python:slim.
# No libssl-dev: the sandbox-validated recipe builds without OpenSSL support
# (internal tooling only), keeping the image's runtime dependencies minimal.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl perl pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Pinned, checksum-verified sources. PostgreSQL release tags use
# underscores (REL_16_15), so the tag is pinned explicitly.
ARG POSTGRES_VERSION=16.15
ARG POSTGRES_TAG=REL_16_15
ARG POSTGRES_SHA256=c1afb748843644f8cc79de12892b9024bc4b82f6c9fe0353c0fcd31aa9fe16ea
ARG ZLIB_VERSION=1.3.2
ARG ZLIB_SHA256=b99a0b86c0ba9360ec7e78c4f1e43b1cbdf1e6936c8fa0f6835c0cd694a495a1

WORKDIR /build

RUN curl -fsSL -o pg.tar.gz \
        "https://codeload.github.com/postgres/postgres/tar.gz/refs/tags/${POSTGRES_TAG}" \
    && echo "${POSTGRES_SHA256}  pg.tar.gz" | sha256sum -c - \
    && curl -fsSL -o zlib.tar.gz \
        "https://codeload.github.com/madler/zlib/tar.gz/refs/tags/v${ZLIB_VERSION}" \
    && echo "${ZLIB_SHA256}  zlib.tar.gz" | sha256sum -c - \
    && mkdir -p zsrc pgsrc \
    && tar xzf zlib.tar.gz -C zsrc --strip-components=1 \
    && tar xzf pg.tar.gz -C pgsrc --strip-components=1 \
    && rm -f zlib.tar.gz pg.tar.gz

# BISON/FLEX are stubbed out for the whole build: pg_dump/pg_restore and
# their libraries contain no generated parser code. psqlscan.c (psql-only)
# is replaced by a compiling stub so flex is not required at all.
# LD_LIBRARY_PATH points at the freshly installed libpq.so so the build-stage
# version self-checks below can run without a system-wide linker update.
ENV BISON=/bin/true FLEX=/bin/true LD_LIBRARY_PATH=/usr/local/pgtools/lib

RUN cd /build/zsrc \
    && ./configure --prefix=/usr/local/pgtools --static \
    && make -j"$(nproc)" \
    && make install \
    && cd /build/pgsrc \
    && PKG_CONFIG_PATH=/usr/local/pgtools/lib/pkgconfig \
        LDFLAGS="-L/usr/local/pgtools/lib" CPPFLAGS="-I/usr/local/pgtools/include" \
        ./configure --prefix=/usr/local/pgtools --without-readline --without-icu --with-zlib \
    && printf '/* Stub: psqlscan.c is only needed by psql; generated placeholder\n * for flex-less client-only builds (pg_dump/pg_restore). */\n' \
        > src/fe_utils/psqlscan.c \
    && for part in src/port src/common src/fe_utils src/interfaces/libpq src/bin/pg_dump; do \
         make -C "$part" -j"$(nproc)"; \
       done \
    && for part in src/port src/common src/fe_utils src/interfaces/libpq src/bin/pg_dump; do \
         make -C "$part" install; \
       done \
    && /usr/local/pgtools/bin/pg_dump --version \
    && /usr/local/pgtools/bin/pg_restore --version

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=UTC \
    PATH="/usr/local/pgtools/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/pgtools/lib"

# PostgreSQL client tools only — no build toolchain in the runtime image.
COPY --from=pgtools /usr/local/pgtools /usr/local/pgtools
RUN echo /usr/local/pgtools/lib > /etc/ld.so.conf.d/pgtools.conf && ldconfig

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY infra/scripts/backup_scheduler.sh /usr/local/bin/backup-scheduler

RUN chmod 0755 /usr/local/bin/backup-scheduler \
    && addgroup --system app \
    && adduser --system --ingroup app --no-create-home app \
    # A named volume mounted over this path inherits its ownership on first
    # use, so the unprivileged process can create backups without root.
    && mkdir -p /var/backups/hr-manager \
    && chown app:app /var/backups/hr-manager

USER app

ENTRYPOINT ["backup-scheduler"]
CMD ["scheduler"]
