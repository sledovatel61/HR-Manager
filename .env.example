# =====================================================================
# HR Manager — пример окружения для ЛОКАЛЬНОЙ разработки.
#
# Скопируйте в файл .env и при необходимости поменяйте значения:
#   cp .env.example .env
#
# ВАЖНО: файл .env в git не коммитится (см. .gitignore).
# Реальные секреты (пароли, токены, ключи) в репозиторий не кладутся.
# Значения по умолчанию в docker-compose рассчитаны только на локальный dev.
# =====================================================================

# Режим приложения: development | test | production
APP_ENV=development

# --- PostgreSQL (сервис db в docker-compose) ---
POSTGRES_USER=hr_manager
# Маркер только для локальной разработки. При APP_ENV=production backend
# откажется работать с этим значением (см. backend/src/hr_manager/core/config.py).
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hr_manager
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# URL для SQLAlchemy. Внутри docker-compose хост БД называется "db".
# Если запускаете backend на хосте (вне docker) — используйте localhost.
DATABASE_URL=postgresql+psycopg://hr_manager:change-me-local-only@db:5432/hr_manager
# DATABASE_URL=postgresql+psycopg://hr_manager:change-me-local-only@localhost:5432/hr_manager

# Секрет приложения. ОБЯЗАТЕЛЕН при APP_ENV=production и должен быть не
# короче 32 символов. В development/test может оставаться пустым.
# Генерация безопасного значения, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Порты наружу (docker-compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
