# HR Manager — environment template.
# Copy to `.env` for local overrides: cp .env.example .env
# `.env` is git-ignored; never commit real secrets.
#
# The values below are the safe DEVELOPMENT defaults used by
# infra/docker-compose.yml. Production requires its own values:
# see infra/compose.prod.yml and infra/scripts/check_env.sh.

# Application environment: development | test | production
APP_ENV=development
APP_DEBUG=true

# Session/security signing key. In production this MUST be a random value
# of at least 32 characters, e.g.: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-not-for-production

# PostgreSQL (development defaults, matching infra/docker-compose.yml)
# DEVELOPMENT ONLY — the values below must never be used in production;
# the backend production guard and infra/scripts/check_env.sh both reject them.
POSTGRES_DB=hr_manager
POSTGRES_USER=hr_manager
POSTGRES_PASSWORD=hr_manager_dev_password

# Backend configuration (set only if you run the backend outside Docker)
# DATABASE_URL=postgresql+psycopg://hr_manager:hr_manager_dev_password@localhost:5432/hr_manager
# DB_CONNECT_TIMEOUT_SECONDS=3

# Sessions and login protection (defaults are shown explicitly)
# SESSION_TTL_MINUTES=30              # idle session lifetime (sliding expiry)
# SESSION_COOKIE_SECURE=              # force Secure cookies (auto-true in production)
# LOGIN_RATE_LIMIT=20                 # max login attempts per IP per window
# LOGIN_RATE_WINDOW_SECONDS=300
# LOGIN_MAX_FAILURES=5                # failed logins before account lock
# LOGIN_LOCK_MINUTES=15

# Initial administrator (created once, when the users table is empty).
# In production BOOTSTRAP_ADMIN_PASSWORD is REQUIRED (the app refuses to
# start with the development default below). Alternatively create the admin
# after startup with: python -m app.cli create-admin --username admin
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=AdminAdmin123   # DEVELOPMENT DEFAULT — change it
# BOOTSTRAP_ADMIN_FULL_NAME=Администратор системы

# Frontend configuration (build/dev-time only, see frontend/.env.example)
# VITE_API_BASE_URL=/api
# HR_API_PROXY_TARGET=http://localhost:8000
