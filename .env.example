# Пример конфигурации для ЛОКАЛЬНОГО запуска (docker compose / разработка).
# Скопируйте в .env:  cp .env.example .env
# Значения ниже — публичные примеры, а не секреты. Файл .env не коммитится.
# Для production каждое значение генерируется отдельно (см. README → Безопасность).

# Среда запуска backend: development | test | production.
# production требует строгого SECRET_KEY/DATABASE_URL и запрещает DEBUG/SQLite.
APP_ENV=development

# --- PostgreSQL (сервис db) ---
POSTGRES_USER=hr_manager
# Пример для локальной разработки; в production — сгенерированный пароль.
POSTGRES_PASSWORD=local-dev-password-change-me
POSTGRES_DB=hr_manager
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Ключ подписи сессий. Минимум 32 символа; для production сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-secret-key-change-me-0123456789abcdef

# --- Frontend ---
FRONTEND_PORT=8080

# По умолчанию порты слушают только 127.0.0.1. Чтобы дать доступ из сети:
# DB_BIND=0.0.0.0 / BACKEND_BIND=0.0.0.0 / FRONTEND_BIND=0.0.0.0
